{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,

    "resolveJsonModule": true,
    "downlevelIteration": false,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "diagnostics*.ts"],
  "exclude": [
    "node_modules",
    "dist"
    // If you still hit unrelated errors from utility CLIs, temporarily exclude them:
    // "tools/**/*.ts"
  ]
}
